  {
   "seq": "3",
   "text": "山櫻さかりにゝほふこの比はうらやましくもみゆる宿かな",
   "kana": "",
   "speaker": "",
   "page": 131,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "君のらは我もおくれしあまを舟みるめと共に年をつみつゝ",
   "kana": "",
   "speaker": "",
   "page": 131,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "かさこしの峯のうへにてみる時は雲はふもとの物にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 131,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "月影のこまのぬしにや誰ならんあなおほつかな空のけしきや",
   "kana": "",
   "speaker": "",
   "page": 131,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "月影のさやかなからにかへさしとくもらむ空のとにつくらん",
   "kana": "",
   "speaker": "",
   "page": 131,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "風をいたみ紅葉ちりしくこの本にかへらん方も忘られにけり",
   "kana": "",
   "speaker": "",
   "page": 131,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "おとにきく音羽の瀧の白糸をむすはゝいかにこなたよはれに",
   "kana": "",
   "speaker": "",
   "page": 131,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "たかせふねしふくはかりにもみち葉の流れてくたる大井川哉",
   "kana": "",
   "speaker": "",
   "page": 131,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "人しれすつゝむ泪にこほれ出るみし日なからにほとをふる哉",
   "kana": "",
   "speaker": "",
   "page": 131,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "忍ひしに心のかきりつきにしをあやしや何のものはおもふそ",
   "kana": "",
   "speaker": "",
   "page": 131,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "秋をわかおしむ心にまかせはやこよひもあけすあすも暮さし",
   "kana": "",
   "speaker": "",
   "page": 131,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "すむ人の心の程は山さとの梅のはなさく春そ見えける",
   "kana": "",
   "speaker": "藤原家經朝臣集",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "うらさひてくすはひかゝる山里の家ゐたつぬる人もあれかし",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "日もくれぬけふは歸らしこし方をそことも見えす野への霞に",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "くすかつらくる人もなき山里に我こそかくはいはまほしけれ",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "あきよりも見る程ひさし夏の夜の月には人をまつへかりけり",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "我やとにわたさはわたせ石はしの下ゆく水もさてそすむへき",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "虚しきをむなしき空とたとへても思ひ〓〓のあるはあるかは",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "これやこの手にとりならす人は皆よゝの佛になるといふもの",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "いそきつゝ我こそきつれ山さとにいつよりすめる秋の月そも",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "いかにしてかきたえにけんもしほ草とはりなりや人の恨むる",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "紅葉ちるをとはしくれの心ちして梢の空はくもらさりけり",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "春は花秋は月にと契りつゝけふをわかれと思はさりせは",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "よし野川みきは凉しとはやきてきいは間の水の音はせねとも",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "音にのみきくたかさこの松風にみやこの秋をおもひいてよ君",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "風ふかはかくれもあらし花薄あきにしられて人まねくとも",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "逢坂のゆきゝも見えす秋霧のたゝぬさきにそこゆへかりける",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "人しれすむすふと思ひしかくれぬの水のゐやしくもりにける哉",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "秋にたにしられさりしを花薄ほのめかすらん風にとはゝや",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "ゆく人もたちそわつらふしかすかの渡りや旅のとまり成らん",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "久方の月はひとつをおはすての山から〓とにみゆるなりけり",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "いはてもやありぬへき迚こ〓ろみに昨日の空は暮しかねてき",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "行人やたつかはきりと見えきらん近くもとりのわたるなる哉",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "人心うきをは更にみちのくのいはてそたゝにいくへかりける",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "秋はたゝまとろむほともふる里のみかきか原そ夢に見えける",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "都人いかにかいふらんやま里の月はこよひとみゆる秋かな",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "野へに出てかりの心や見えにけんきしかたくゆる人を社きけ",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "山さとはみきはのきくの咲時そ音なき人のかけも見えける",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "おほつかなかりはのをのゝきし方をくゆるや誰そ戀するや我",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "中〓〓にかたえもみちぬ折にこそ靑葉にはゆる色は見えけれ",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "うれしくも加茂のかはらの川みつにふかき心をしらせつる哉",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "なに〓ももににかなふ身ならねはよのつねならぬ戀もするかな",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "梅かえに驚たてゝすへなからかつなかせつゝうつしうへてん",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "ねぬ人そしるへかりけるかみな月時雨は袖の名にこそ有けれ",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "鶯はこれにそきゐる梅のはなまつさく方の枝なたかへそ",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "山里はみちもや見えすなりぬらん紅葉とゝもに雪のふりぬる",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "うの花のたはゝにさける盛りにはゑ□なる枝そかさね成ける",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "戀わひぬあすはいさよひ月かけのけにや出ぬと待こゝろみん",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "まちいてゝもねられさりけり時鳥なきなん後と思ひしかとも",
   "kana": "",
   "speaker": "",
   "page": 132,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "うらみむと思ふへしやはいさり船なみまもまたてかへる心は",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "いつ方をまたてひきける菖蒲草ねたしやれたしかけてやみ南",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "五月こそいつかはひきし萬蒲草かけてもしらぬとこな恐れそ",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "いさりふね浪まもまたしいつみなるしのたの森の風も吹なり",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "いさり船浪や風やに〓つつけてうらよりをちに成とこそ見れ",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "こも枕かりのたひねにあかさはや入江の蘆のひとよはかりに",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "まこも草かりそめにとて明さなん長くもあらす夏のしのゝめ",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "時雨せぬ夏たにふかきもみ葉はけふより後の色そゆかしき",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "心のみすめはすみふるしはのとを入にし日よりとふ人もなし",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "たひねする君か玉章かくやとてまたき木のはの色つきぬらん",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "思ひゐて心のやみし晴ぬれは雲かくれにし月も見えけり",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "わたるせにこそもふけにし天の河ふなて計はよるならてせよ",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "風ふけはかはへすゝしくよる浪の立かへるへき心ちこそせれ",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "降つもるあさちかうへの白雪にゆくへき道もわすられにけり",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "草枕つゆはをくともとこ夏の花しさきなは野邊にこそれめ",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "あやなしや淺茅かうへの〓との葉にふなてする身の心とゝむる",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "いさり船こきもやゆくと思ひしをよさの浦浪ひまなかりけり",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "今夜わかうらやましきをたちかへりあすは都にいてん月かも",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "ゆきめくりみやこに出る月影のいりつるにしを忘れかねつも",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "こきゆけと離れぬかけを久かたの月のふねとや人はみろうん",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "尋ねこし花にもあかすくれぬれは春の過ぬる心ちゝそすれ",
   "kana": "",
   "speaker": "星説月イ",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "我袖のしつくとやみる奧山のもみちしらする谷川の水",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "年をへてかしらの雪はつもれともおしむに花もとまらさり鳬",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "もみち葉の外よりたかく積れるやきくのさけりし所なるらん",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "散殘る花もやあると尋ねつるやとの櫻も殘らさりけり",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "梅の花ちるこのしたに行水のなかれをみてや人のきつらん",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "とこ夏に匂へる花の色よりもおれる心のほとをこそ見れ",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "時鳥待そかひなき山ちかみなにゆへにすむやとならなくに",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "ふかき色わきて折つるとこ夏の花に心の見えにけるかな",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "あやめ草人のかるにもわか駒はひきとめらるゝ物にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "たつたひめ〓とにやそめし春も秋もとこ夏にして花のなきかな",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "あまのかはみきは涼しき秋風にけふはあふきの風も忘れぬ",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "わか宿にしらて待らんもみち葉のあかぬ心にけふはくらしつ",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "さ苗とる時しきぬれはみたや守まかする水におりたちにけり",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "郭公なく山さとのかきねをはかきたえすこそとふへかりけれ",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "山さとのまきの葉しのき降雪にいかてか人の尋ね來つらん",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "かけやとす水のにこると見えつるは空なる月や雲かくるらん",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "荻の葉に秋をしらせて風の音の松に木高く聞ゆなるかな",
   "kana": "",
   "speaker": "",
   "page": 133,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "よとゝもにくもらぬ雲のうへなれは思ふ〓となく月をみるかな",
   "kana": "",
   "speaker": "藤原家經朝臣集",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "うへしとき花咲にけり我のみそ春にしられぬためしなりける",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "さてもなをあかすやあると山櫻花をときはにみるよしもかな",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "しのひれもまたしかるらん郭公やとからなれや鳴渡るなり",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "時鳥かたらふ聲を聞ときはまたと〓〓そおほえさりける",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "待にこそねぬよへにけれ時島我もきゝつといはまほしさに",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "しかのねそねさめの床にかよふなるをのゝ草ふし露や置らん",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "花薄しはしなひかてこゝろみよふきくる風もさためなきよに",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "紅葉する山の時雨を音にのみきくそよにふるかひなかりける",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "ほともなく明ぬる夏の月かけもひとりみるよは久しかりけり",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "音にこそきくへかりけれしくれする山の紅葉に心まとひき",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "さそはるゝ心とならは山さとに月をいるまて見てそゆかまし",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "うちこえん駒のあし音たえすしてくめのさら山行かへりなん",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "まてとたになけの童□きかませはいる迄月をみさらましやは",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "ゆきかへりくめのさら山こえぬへき駒の足こそ嬉しかりけれ",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "したくゝる岩間の水のあたりにはあふきの風をかる人もなし",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "笛のねは月に高くそ聞ゆなるみちのそらにてよや更ぬらん",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "夏の夜の月し出れは山のはもやかて明ぬるものにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "ねさめして後も久しき冬のよはおひぬるひとそ先しられける",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "秋をのみ立ゐまつかなたなはたの渡る川瀬の浪ならなくに",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "高砂のまつとてけふそ暮しつるふなちはともそとまりえける",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "まつとたにいかてきかまし浪間わけとわたる船の便ならすは",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "ちりのこる花もたつれて見るへきにふなちに春も暮にける哉",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "なには江のあしまにゝほふ山吹の花をいてかと思ひけるかな",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "ふりすてゝ君しもゆかし難波方あしのつのくむ春もきぬるに",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "命あらは世かたりにせん思ひ出てなにはの浦にあへる君かな",
   "kana": "",
   "speaker": "",
   "page": 134,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  }
 ],
